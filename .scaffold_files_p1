                    flows, a mistyped link) must not be a blank page. */}
                <Route path="*" element={<RouteNotFound />} />
              </Route>
            </Routes>
            </LocaleGate>
        </HashRouter>
      </ErrorBusProvider>
    </ErrorBoundary>
  );
}

